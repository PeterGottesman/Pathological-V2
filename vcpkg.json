{
  "name": "pathological-v2",
  "version": "0.1.0",
  "dependencies": [
    "cli11",
    "grpc",
    "protobuf",
    "boost-uuid",
    {
      "name": "aws-sdk-cpp",
      "features": [
        "s3"
      ]
    }
  ],
  "features": {
    "scheduler": {
      "description": "Extra dependencies needed to build the scheduler",
      "dependencies": [
        "drogon"
      ]
    },
    "render-worker": {
      "description": "Extra dependencies needed to build the render worker",
      "dependencies": [
        "vulkan-memory-allocator",
        "glm",
        "stb",
        "tinygltf"
      ]
    }
  }
}
